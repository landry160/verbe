{
  "name": "verbe",
  "productName": "Verbe",
  "version": "0.6.2",
  "description": "Verbe : dictée vocale. Raccourci partout, bulle ronde, collage automatique.",
  "author": "Landry Tchuente Tchouela",
  "license": "MIT",
  "main": "bureau/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "raccourci": "node bureau/installer-raccourci.js",
    "installateur": "vite build && electron-builder --win nsis --x64 --publish never",
    "pretest": "vite build",
    "test": "tsc -p tsconfig.json && vitest run && playwright test",
    "test:web": "vite build && playwright test --project=web",
    "test:bureau": "vite build && playwright test --project=bureau",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "dev:bureau": "node bureau/dev.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "com.landrytchouela.verbe",
    "productName": "Verbe",
    "copyright": "Landry Tchuente Tchouela",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "bureau/**",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**"
    ],
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "landry160",
        "repo": "verbe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "bureau/icone.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Verbe-Setup.exe",
      "shortcutName": "Verbe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "bureau/icone.ico",
      "uninstallerIcon": "bureau/icone.ico",
      "uninstallDisplayName": "Verbe"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "koffi": "2.9.1"
  }
}
