{
  "name": "verbe",
  "productName": "Verbe",
  "version": "0.4.4",
  "description": "Verbe : dictée vocale. Raccourci partout, bulle ronde, collage automatique.",
  "author": "Landry Tchuente Tchouela",
  "main": "bureau/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "raccourci": "node bureau/installer-raccourci.js",
    "installateur": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.landrytchouela.verbe",
    "productName": "Verbe",
    "copyright": "Landry Tchuente Tchouela",
    "directories": { "output": "dist" },
    "files": ["app/**", "bureau/**", "package.json"],
    "asar": false,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "bureau/icone.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Verbe-Setup-${version}.exe",
      "shortcutName": "Verbe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "bureau/icone.ico",
      "uninstallerIcon": "bureau/icone.ico",
      "uninstallDisplayName": "Verbe"
    }
  }
}
